<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bariq — Home</title>
  <style>
    :root{
      --bg:#fbfaf7;
      --line:rgba(86,62,124,0.10);
      --text:#2f2540;
      --muted:#756d7f;
      --gold:#d8b66a;
      --gold-deep:#b78c35;
      --purple:#6f4aaa;
      --purple-deep:#4f2f85;
      --green:#7ea78d;
      --shadow:0 18px 50px rgba(88,60,130,0.10);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter, Arial, sans-serif;
      color:var(--text);
      min-height:100vh;
      background:
        radial-gradient(circle at 10% 10%, rgba(216,182,106,0.16), transparent 20%),
        radial-gradient(circle at 90% 14%, rgba(126,167,141,0.14), transparent 18%),
        radial-gradient(circle at 80% 70%, rgba(111,74,170,0.10), transparent 22%),
        linear-gradient(180deg,#fcfbf8 0%, #f7f2ea 45%, #faf8f4 100%);
    }
    .wrap{
      max-width:1200px;
      margin:0 auto;
      padding:28px;
    }
    .top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      margin-bottom:28px;
    }
    .brand{
      font-size:34px;
      font-weight:800;
      letter-spacing:-0.04em;
      color:var(--purple-deep);
    }
    .brand span{ color:var(--gold-deep); }
    .hero{
      background:rgba(255,255,255,0.82);
      border:1px solid var(--line);
      border-radius:30px;
      padding:34px;
      box-shadow:var(--shadow);
    }
    h1{
      margin:0 0 12px;
      font-size:56px;
      line-height:0.98;
      letter-spacing:-0.05em;
    }
    p{
      margin:0 0 24px;
      color:var(--muted);
      font-size:18px;
      line-height:1.7;
      max-width:800px;
    }
    .grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:16px;
      margin-top:26px;
    }
    .card{
      display:block;
      text-decoration:none;
      background:white;
      border:1px solid var(--line);
      border-radius:22px;
      padding:20px;
      color:var(--text);
      box-shadow:0 10px 28px rgba(88,60,130,0.06);
    }
    .card strong{
      display:block;
      font-size:18px;
      margin-bottom:8px;
    }
    .card span{
      color:var(--muted);
      font-size:14px;
      line-height:1.6;
    }
    @media (max-width:900px){
      .grid{grid-template-columns:1fr}
      h1{font-size:40px}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="top">
      <div class="brand">Bariq <span>AI</span></div>
    </div>

    <section class="hero">
      <h1>Bariq AI Studio</h1>
      <p>
        A premium workspace for creating ads, campaigns, scripts, and AI-powered marketing ideas.
        Start from the create page or open one of the connected tools below.
      </p>

      <div class="grid">
        <a class="card" href="/create.html">
          <strong>Create</strong>
          <span>Generate copy, scripts, captions, and search matching visuals.</span>
        </a>

        <
