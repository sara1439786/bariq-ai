    };

    function formatBudget(value) {
      const num = Number(value || 0);
      if (!num) return "₹0";
      return `₹${Math.round(num / 1000)}K`;
    }

    function updateCreatorRecommendations() {
      const category = document.getElementById("businessCategory").value;
      const data = categoryData[category];
      document.getElementById("creatorNeed").textContent = data.need;
      document.getElementById("shortlistCount").textContent = data.creators.length;

      document.getElementById("creatorList").innerHTML = data.creators.map(c => `
        <div class="creator-card">
          <strong>${c.name}</strong>
          <span>${c.text}</span>
          <div class="tags">${c.tags.map(tag => `<div class="tag">${tag}</div>`).join("")}</div>
        </div>
      `).join("");
    }

    function buildCampaignSummary() {
      const name = document.getElementById("campaignName").value;
      const category = document.getElementById("businessCategory").value;
      const goal = document.getElementById("campaignGoal").value;
      const city = document.getElementById("campaignCity").value;
      const budget = document.getElementById("campaignBudget").value;
      const timeline = document.getElementById("campaignTimeline").value;
      const offer = document.getElementById("campaignOffer").value;
      const collab = document.getElementById("collabType").value;
      const audience = document.getElementById("campaignAudience").value;
      const message = document.getElementById("campaignMessage").value;

      document.getElementById("campaignSummaryOutput").textContent =
`Campaign Summary

Campaign Name: ${name}
Business Category: ${category}
Goal: ${goal}
Target City: ${city}
Budget: ₹${Number(budget).toLocaleString("en-IN")}
Timeline: ${timeline}
Collaboration Type: ${collab}

Offer:
${offer}

Audience:
${audience}

Core Message:
${message}

Execution Direction:
1. Import AI assets into campaign flow
2. Match creators by category and audience
3. Share brief and content expectations
4. Move to business review
5. Launch and track from admin dashboard`;

      document.getElementById("campaignStatus").textContent = "Ready for Review";
      document.getElementById("budgetStat").textContent = formatBudget(budget);
      document.getElementById("launchReadiness").textContent = "92%";

      document.getElementById("trackingBody").innerHTML = `
        <tr>
          <td>${name}</td>
          <td>${goal}</td>
          <td>₹${Number(budget).toLocaleString("en-IN")}</td>
          <td>${document.getElementById("creatorNeed").textContent}</td>
          <td><span class="pill warning">Review</span></td>
        </tr>
        <tr>
          <td>Festival Offer Push</td>
          <td>Awareness</td>
          <td>₹18,000</td>
          <td>3 shortlisted</td>
          <td><span class="pill success">Ready</span></td>
        </tr>
      `;
    }

    function saveDraft() {
      const draft = {
        campaignName: document.getElementById("campaignName").value,
        businessCategory: document.getElementById("businessCategory").value,
        campaignGoal: document.getElementById("campaignGoal").value,
        campaignCity: document.getElementById("campaignCity").value,
        campaignBudget: document.getElementById("campaignBudget").value,
        campaignTimeline: document.getElementById("campaignTimeline").value,
        campaignOffer: document.getElementById("campaignOffer").value,
        collabType: document.getElementById("collabType").value,
        campaignAudience: document.getElementById("campaignAudience").value,
        campaignMessage: document.getElementById("campaignMessage").value
      };

      localStorage.setItem("bariq_campaign_draft", JSON.stringify(draft));
      document.getElementById("campaignStatus").textContent = "Draft Saved";
      alert("Campaign draft saved");
    }

    function loadAiData() {
      const aiOutput = localStorage.getItem("aiOutput") || "";
      const aiBusiness = localStorage.getItem("aiBusiness") || "";
      const aiOffer = localStorage.getItem("aiOffer") || "";

      if (aiBusiness) {
        document.getElementById("campaignName").value = aiBusiness + " Launch";
        document.getElementById("campaignMessage").value = aiOutput || document.getElementById("campaignMessage").value;
      }

      if (aiOffer) {
        document.getElementById("campaignOffer").value = aiOffer;
      }

      document.getElementById("assetConnection").textContent = aiOutput ? "AI Generator content imported successfully" : "No AI output found yet";

      document.getElementById("assetList").innerHTML = `
        <div class="asset-card">
          <strong>Meta Ad Copy</strong>
          <span>${aiOutput || "No AI data found yet. Go to AI Generator and click Generate first."}</span>
          <div class="tags">
            <div class="tag">${aiOutput ? "Imported" : "Waiting"}</div>
            <div class="tag">AI Output</div>
          </div>
        </div>

        <div class="asset-card">
          <strong>Offer Input</strong>
          <span>${aiOffer || "No offer imported yet."}</span>
          <div class="tags">
            <div class="tag">Offer</div>
            <div class="tag">Connected</div>
          </div>
        </div>

        <div class="asset-card">
          <strong>Business Input</strong>
          <span>${aiBusiness || "No business type imported yet."}</span>
          <div class="tags">
            <div class="tag">Business</div>
            <div class="tag">Connected</div>
          </div>
        </div>
      `;

      alert(aiOutput ? "AI data loaded successfully" : "No AI data found. Generate content first.");
    }

    function exportToBusinessDashboard() {
      const latestCampaign = {
        campaignName: document.getElementById("campaignName").value,
        businessCategory: document.getElementById("businessCategory").value,
        campaignGoal: document.getElementById("campaignGoal").value,
        campaignCity: document.getElementById("campaignCity").value,
        campaignBudget: document.getElementById("campaignBudget").value,
        campaignOffer: document.getElementById("campaignOffer").value,
        campaignAudience: document.getElementById("campaignAudience").value,
        campaignMessage: document.getElementById("campaignMessage").value
      };

      localStorage.setItem("bariq_latest_campaign", JSON.stringify(latestCampaign));
      alert("Campaign exported to Business Dashboard");
    }

    function launchCampaign() {
      saveDraft();
      alert("Campaign launched successfully");
      document.getElementById("campaignStatus").textContent = "Live";
      document.getElementById("launchReadiness").textContent = "100%";
    }

    function resetCampaign() {
      document.getElementById("campaignName").value = "Laser Hair Reduction Launch";
      document.getElementById("businessCategory").value = "Clinic / Aesthetic Center";
      document.getElementById("campaignGoal").value = "Lead Generation";
      document.getElementById("campaignCity").value = "Hyderabad";
      document.getElementById("campaignBudget").value = "25000";
      document.getElementById("campaignTimeline").value = "7 Days";
      document.getElementById("campaignOffer").value = "Unlimited sessions from ₹8,999";
      document.getElementById("collabType").value = "Reels + Stories";
      document.getElementById("campaignAudience").value = "Women 23-45 seeking a safer, smarter alternative to waxing with better convenience and confidence.";
      document.getElementById("campaignMessage").value = "Promote safe, women-focused Laser Hair Reduction in Hyderabad with strong offer communication, local trust, and creator-led content.";
      document.getElementById("campaignStatus").textContent = "Draft";
      document.getElementById("assetConnection").textContent = "Ready to import from AI Generator";
      document.getElementById("budgetStat").textContent = "₹25K";
      document.getElementById("launchReadiness").textContent = "84%";
      updateCreatorRecommendations();
      buildCampaignSummary();
    }

    document.getElementById("businessCategory").addEventListener("change", updateCreatorRecommendations);
    document.getElementById("buildCampaignBtn").addEventListener("click", buildCampaignSummary);
    document.getElementById("buildCampaignBtnTop").addEventListener("click", buildCampaignSummary);
    document.getElementById("saveCampaignBtn").addEventListener("click", saveDraft);
    document.getElementById("loadAiBtn").addEventListener("click", loadAiData);
    document.getElementById("exportCampaignBtn").addEventListener("click", exportToBusinessDashboard);
    document.getElementById("launchCampaignBtn").addEventListener("click", launchCampaign);
    document.getElementById("resetCampaignBtn").addEventListener("click", resetCampaign);

    updateCreatorRecommendations();
